# D060 single-database contract only. No dotenv loader; production always refuses activation.
# Do not create or enter real credentials/keys yet. All values below are placeholders.
# Server-owned settings: never supply these as APP_* secrets or override on the server.
# DATABASE_URL=postgres://music_app:REPLACE_PASSWORD@postgres:5432/music
# PORT=3000
# NODE_ENV=production

# App-owned NAME later becomes GitHub APP_NAME, stripped by the operator's deploy helper.
ORGANISER_ORIGIN=https://music.example.invalid
ORGANISER_CALLBACK=https://music.example.invalid/callback
ORGANISER_ACCOUNT=REPLACE_ORGANISER_ACCOUNT_UUID
ORGANISER_OWNER=REPLACE_VERIFIED_SPOTIFY_ID
SPOTIFY_CLIENT_ID=REPLACE_PUBLIC_CLIENT_ID

# Ring encoding: version:64hex[,version:64hex]; no spaces or repeated versions/material.
# Keep old versions while retained data/backups/rollback images need them.
# Independent credential and snapshot keys; CURRENT must name a ring member.
ORGANISER_CREDENTIAL_KEYS=REPLACE_VERSIONED_CREDENTIAL_KEYS
ORGANISER_CREDENTIAL_CURRENT=REPLACE_CURRENT_VERSION
ORGANISER_SNAPSHOT_KEYS=REPLACE_VERSIONED_SNAPSHOT_KEYS
ORGANISER_SNAPSHOT_CURRENT=REPLACE_CURRENT_VERSION

# 9 app-owned settings, below the helper's 32-setting maximum. Single-line values,
# <=4096 characters, no controls/apostrophe/backslash. Do not log configuration objects.
# Only server-supplied DATABASE_URL is used; migration/journal URLs and journal keys are rejected.
# No URL query/hash or libpq options; private server network uses ssl:false.
# ORGANISER_DATABASE and ORGANISER_KEY are rejected legacy aliases.
# Never set ORGANISER_SYNTHETIC, VITE_ secrets, SPOTIFY_CLIENT_SECRET or SESSION_SECRET.
# R2/age credentials belong to the operator's backup system, not this app.

# D056 prepared same-image setup only, not production activation. Optional pair:
# SETUP_MODE=1
# SETUP_TOKEN=REPLACE_WITH_APPROVED_43_TO_128_CHARACTER_BASE64URL_TOKEN
# Later remove BOTH APP_SETUP_MODE and APP_SETUP_TOKEN in the return-to-normal deploy.
# Normal mode rejects a leftover token. Never place the token in a URL or log.
# 11 app-owned settings while setup is enabled, 9 in normal mode.
