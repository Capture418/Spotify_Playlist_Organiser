{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".work/runtime",
    "rewriteRelativeImportExtensions": true,
    "incremental": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
