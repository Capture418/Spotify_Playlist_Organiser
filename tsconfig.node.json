{
  "compilerOptions": {
    "tsBuildInfoFile": "./.work/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "src/**/*.test.ts",
    "scripts/spotify/**/*.ts",
    "server/**/*.ts",
    "scripts/database/**/*.ts"
  ]
}
